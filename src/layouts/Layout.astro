---
import '../styles/global.css'
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body class="min-h-screen flex flex-col bg-white text-neutral-900 antialiased">

    <!-- ================= NAVBAR ================= -->
    <header
      id="site-header"
      class="sticky top-0 z-50 backdrop-blur-lg bg-white/70 border-b border-transparent transition-all duration-300 opacity-0 animate-fade-in"
    >
      <nav class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">

        <!-- Logo -->
        <a href="/" class="text-lg md:text-2xl font-semibold tracking-tight">
          Samiran Ghosh
        </a>

        <!-- Desktop Nav -->
        <div class="hidden md:flex items-center gap-10 text-sm font-medium text-neutral-600">

          <a href="/#about" class="nav-link">About</a>
          <a href="/blog" class="nav-link">Blog</a>
          <a href="mailto:samiranghoshofficial04@gmail.com" class="nav-link">Contact</a>
          <a href="https://github.com/samiranghosh04" target="_blank" class="nav-link">GitHub</a>
          <a href="https://linkedin.com/in/samiranghosh04" target="_blank" class="nav-link">LinkedIn</a>

        </div>

        <!-- Mobile Button -->
        <button id="menu-btn" class="md:hidden text-sm font-medium text-neutral-700">
          Menu
        </button>
      </nav>

      <!-- Mobile Menu -->
      <div
        id="mobile-menu"
        class="hidden md:hidden px-6 pb-6 space-y-4 text-sm font-medium text-neutral-600"
      >
        <a href="/#about" class="block">About</a>
        <a href="/blog" class="block">Blog</a>
        <a href="mailto:samiranghoshofficial04@gmail.com" class="block">Contact</a>
        <a href="https://github.com/samiranghosh04" target="_blank" class="block">GitHub</a>
        <a href="https://linkedin.com/in/samiranghosh04" target="_blank" class="block">LinkedIn</a>
      </div>
    </header>

    <!-- ================= MAIN ================= -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="border-t border-neutral-200 bg-neutral-50 mt-32">

      <div class="max-w-6xl mx-auto px-6 py-20 grid md:grid-cols-4 gap-12 text-sm">

        <!-- Brand -->
        <div>
          <p class="font-semibold text-neutral-900 text-xl mb-4">
            Samiran Ghosh
          </p>
          <p class="text-neutral-600 leading-relaxed">
            Software Engineer focused on performance,
            architecture, and scalable systems.
          </p>
        </div>

        <!-- Pages -->
        <div>
          <div class="space-y-3 text-neutral-600 flex flex-col">
            <a href="/" class="footer-link">Home</a>
            <a href="/blog" class="footer-link">Blog</a>
            <a href="/#about" class="footer-link">About</a>
          </div>
        </div>

        <!-- Contact -->
        <div>
          <div class="space-y-3 text-neutral-600 flex flex-col">
            <a href="mailto:samiranghoshofficial04@gmail.com" class="footer-link">
              Email
            </a>
            <a href="https://github.com/samiranghosh04" target="_blank" class="footer-link">
              GitHub
            </a>
            <a href="https://linkedin.com/in/samiranghosh04" target="_blank" class="footer-link">
              LinkedIn
            </a>
          </div>
        </div>

        
        <!-- Writing -->
        <div>
          <div class="space-y-3 text-neutral-600 flex flex-col">
            <a href="https://medium.com/@samiranghoshofficial04" target="_blank" class="footer-link">Medium</a>
            <!--<a href="https://substack.com/@yourprofile" target="_blank" class="footer-link">Substack</a>-->
          </div>
        </div>

      </div>

      <div class="border-t border-neutral-200 py-6 text-center text-xs text-neutral-500">
        © 2026 Samiran Ghosh. All rights reserved.
      </div>
    </footer>

    <!-- ================= SCRIPTS ================= -->
    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      const header = document.getElementById('site-header');

      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });

      window.addEventListener('scroll', () => {
        if (window.scrollY > 10) {
          header?.classList.add('border-neutral-200', 'shadow-sm');
          header?.classList.remove('border-transparent');
        } else {
          header?.classList.remove('border-neutral-200', 'shadow-sm');
          header?.classList.add('border-transparent');
        }
      });
    </script>

  </body>
</html>
